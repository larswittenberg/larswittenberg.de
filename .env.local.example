# https://github.com/settings/personal-access-tokens
GH_TOKEN=
GH_USERNAME=

# Vercel Blob - für Twitter-Medien (yarn blob:upload)
# https://vercel.com/lars-wittenbergs-projects/larswittenberg-de/stores/blob/store_1u5HTcj0C4svlgnX/guides
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Github Stars
USE_FAKE_API=false
NEXT_PUBLIC_ENABLE_GITHUB_DEBUG=true
ENABLE_GITHUB_DEBUG=true

# Strava Dashboard Login
STRAVA_DASHBOARD_PASSWORD=
STRAVA_SESSION_SECRET=

# STRAVA API
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
