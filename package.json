{
  "name": "larswittenberg.de",
  "description": "My personal website built with Next.js & TailwindCSS",
  "version": "2.1.0",
  "author": {
    "name": "Lars Wittenberg",
    "url": "https://larswittenberg.de"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/larswittenberg/larswittenberg.de"
  },
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "next dev",
    "build:tweets": "node scripts/generate-tweets-json.mjs",
    "build": "next build",
    "start": "next start",
    "clean": "npx rimraf .next",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write ./src",
    "export": "npx rimraf .next && npx rimraf out && next build && next export",
    "update-stars": "node ./src/scripts/fetch-starred-repos.js",
    "blob:upload": "node scripts/upload-to-blob.mjs",
    "strava:import": "tsx scripts/import-strava.ts",
    "verify": "yarn lint && yarn typecheck && yarn format && yarn build"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/speed-insights": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "next-mdx-remote": "^6.0.0",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.4.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-is": "^19",
    "csv-parser": "^3.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^3.8.5",
    "shadcn-ui": "^0.9.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
